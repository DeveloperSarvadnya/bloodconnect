# Template only — copy to secret.yaml, fill in real values, and NEVER commit it.
# secret.yaml is gitignored. Applied separately from kustomize:
#   k3s kubectl apply -f k8s/base/secret.yaml -n bloodconnect-<env>
#
# In the real pipeline, Ansible creates this from group_vars/all.yml instead
# of a checked-in file — see ansible/playbooks/k8s_deploy.yml.
apiVersion: v1
kind: Secret
metadata:
  name: bloodconnect-secrets
type: Opaque
stringData:
  NEXT_PUBLIC_SUPABASE_ANON_KEY: "your-anon-key"
